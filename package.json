{
  "name": "air2growth-web-htmx-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal complete htmx starter on Bun native HTTP server.",
  "scripts": {
    "build:css": "bunx @tailwindcss/cli -i ./src/styles.css -o ./public/styles.css",
    "build": "bun run build:css",
    "dev:server": "bun --hot server.ts",
    "dev:css": "bunx @tailwindcss/cli -i ./src/styles.css -o ./public/styles.css --watch",
    "dev": "bun scripts/dev.ts",
    "start": "bun run build:css && bun server.ts"
  },
  "dependencies": {
    "@tailwindcss/cli": "4.1.14",
    "htmx.org": "2.0.11",
    "tailwindcss": "4.1.14"
  }
}
